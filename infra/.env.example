# Copy to infra/.env and set values before running in production.
# docker compose reads this file automatically when run from the infra/ directory.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=mastermind
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mastermind
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Auth secrets (CHANGE THESE IN PRODUCTION) ────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_AGENT_SECRET=change-me-in-production
PLAYER_JWT_SECRET=change-me-in-production
PLAYER_SESSION_SECRET=change-me-in-production
EMAIL_VERIFICATION_SECRET=change-me-in-production
# Historical name retained for ciphertext compatibility; protects all stored
# integration credentials (OpenAI, Moonshot/Kimi, Cloudflare, DigitalOcean, and Mailgun).
OPENAI_KEY_ENCRYPTION_SECRET=change-me-in-production
AUTH_RATE_LIMIT_SECRET=change-me-in-production

# Optional explicit bootstrap administrator. Public registrations never become
# administrators automatically. Leave password blank once the account exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# ── Ports ─────────────────────────────────────────────────────────────────────
# Loopback is the secure default for a reverse-proxied installation. Set this
# to a trusted LAN address only when browsers must connect directly.
BIND_ADDRESS=127.0.0.1
CP_PORT=3001
WEB_PORT=3000

# ── Web build arg (must match the public URL users see in their browser) ──────
NEXT_PUBLIC_CONTROL_PLANE_URL=http://localhost:3001
PLAYER_PORTAL_SERVER_ID=
PUBLIC_WEB_URL=http://localhost:3000

# Stripe Checkout (player donations via name or optional Steam). Leave blank to disable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Minecraft agent (runs on the game host, not in Compose) ───────────────────
# Set these in agent/.env.agent on the host that owns the pack install:
#   MASTERMIND_CONTROL_PLANE_URL=https://your-control-plane
#   MASTERMIND_MC_INSTALL_PATH=C:/path/to/minecraft-server
#   MASTERMIND_PAIRING_TOKEN=...
# See docs/production-deploy.md

# ── Optional Discord command bot (`--profile discord-bot`) ───────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_ROLE_IDS=
DISCORD_ALLOWED_USER_IDS=
DISCORD_EPHEMERAL_REPLIES=true
MASTERMIND_URL=http://control-plane:3001
MASTERMIND_EMAIL=
MASTERMIND_PASSWORD=
MASTERMIND_ORG_ID=
MASTERMIND_SERVER_ID=
JOB_TIMEOUT_SECONDS=600
