// Mastermind Control Plane — PostgreSQL schema (MVP)
// Multi-tenant (org), server-scoped permissions, audit-ready, job history, multi-game ready.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant & identity ─────────────────────────────────────────────────────
model Org {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  discordWebhookUrl   String?  @map("discord_webhook_url") // one webhook per org for MVP
  logRetentionDays    Int      @default(7) @map("log_retention_days")
  healthIntervalSec   Int      @default(10) @map("health_interval_sec")
  stabilityRestartEnabled Boolean @default(true) @map("stability_restart_enabled")
  stabilityRestartMemoryGiB Int @default(12) @map("stability_restart_memory_gib")
  stabilityRestartCooldownMinutes Int @default(240) @map("stability_restart_cooldown_minutes")
  openaiApiKeyEncrypted String?  @map("openai_api_key_encrypted") @db.Text
  openaiModel           String   @default("gpt-5.3-codex") @map("openai_model")
  modAiProvider         String   @default("codex") @map("mod_ai_provider")
  kimiApiKeyEncrypted   String?  @map("kimi_api_key_encrypted") @db.Text
  kimiModel             String   @default("kimi-for-coding") @map("kimi_model")
  cloudflareApiTokenEncrypted String? @map("cloudflare_api_token_encrypted") @db.Text
  digitalOceanApiTokenEncrypted String? @map("digitalocean_api_token_encrypted") @db.Text
  mailgunApiKeyEncrypted String? @map("mailgun_api_key_encrypted") @db.Text
  mailgunDomain          String? @map("mailgun_domain")
  mailgunFromEmail       String? @map("mailgun_from_email")
  mailgunRegion          String  @default("us") @map("mailgun_region")
  recaptchaSiteKey       String? @map("recaptcha_site_key")
  recaptchaSecretEncrypted String? @map("recaptcha_secret_encrypted") @db.Text
  stripeSecretKeyEncrypted String? @map("stripe_secret_key_encrypted") @db.Text
  stripeWebhookSecretEncrypted String? @map("stripe_webhook_secret_encrypted") @db.Text
  maintenancePasswordEncrypted String? @map("maintenance_password_encrypted") @db.Text
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  userOrgs         UserOrg[]
  hosts            Host[]
  pairingTokens   PairingToken[]
  serverInstances  ServerInstance[]
  jobs             Job[]
  jobBatches       JobBatch[]
  events           Event[]
  alertRules       AlertRule[]
  orgBans          OrgBan[]
  banEntries       BanEntry[]
  auditLogs        AuditLog[]
  modArtifacts     ModArtifact[]
  commandMacros    CommandMacro[]
  schedules        Schedule[]
  serverLogs       ServerLog[]
  healthSamples    HealthSample[]
  players          Player[]
  donations        Donation[]
  shopItems        ShopItem[]
  triggers         Trigger[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?  @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  emailVerificationSentAt DateTime? @map("email_verification_sent_at")
  approvedAt   DateTime? @map("approved_at")
  approvedById String?   @map("approved_by_id")
  authVersion  Int       @default(1) @map("auth_version")
  createdAt    DateTime @default(now()) @map("created_at")

  userOrgs          UserOrg[]
  userServerRoles   UserServerRole[]
  jobsCreated       Job[]            @relation("JobCreatedBy")
  jobBatchesCreated JobBatch[]       @relation("JobBatchCreatedBy")
  orgBansCreated    OrgBan[]         @relation("OrgBanCreatedBy")
  banEntriesCreated BanEntry[]       @relation("BanEntryCreatedBy")
  auditLogs         AuditLog[]
  pairingTokens     PairingToken[]
  commandMacrosCreated CommandMacro[]
  schedulesCreated    Schedule[]
  triggersCreated     Trigger[]
}

// Persistent, privacy-preserving authentication throttle buckets. Keys are
// HMACs of normalized account/IP dimensions; raw client IPs are never stored.
model AuthRateLimit {
  keyHash         String    @id @map("key_hash")
  failures        Int       @default(0)
  windowStartedAt DateTime  @map("window_started_at")
  blockedUntil    DateTime? @map("blocked_until")
  lockoutLevel    Int       @default(0) @map("lockout_level")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("auth_rate_limits")
}

// Lifetime public-registration quota. Only an HMAC of the source IP is kept;
// raw registration addresses are never stored in this table.
model RegistrationIpQuota {
  ipHash            String   @id @map("ip_hash")
  registrationCount Int      @default(0) @map("registration_count")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("registration_ip_quotas")
}

model Role {
  id   String @id @default(cuid())
  name String @unique // admin | operator | viewer

  userOrgs        UserOrg[]
  userServerRoles UserServerRole[]
}

model UserOrg {
  userId    String   @map("user_id")
  orgId     String   @map("org_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, orgId])
  @@index([orgId])
}

// Server-scoped role override (optional; if missing, org role applies)
model UserServerRole {
  userId           String @map("user_id")
  serverInstanceId String @map("server_instance_id")
  roleId           String @map("role_id")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverInstance ServerInstance @relation(fields: [serverInstanceId], references: [id], onDelete: Cascade)
  role           Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, serverInstanceId])
  @@index([serverInstanceId])
}

// ─── Hosts & game servers ──────────────────────────────────────────────────
model GameType {
  id           String   @id @default(cuid())
  slug         String   @unique // e.g. "7dtd", "minecraft"
  name         String
  configSchema Json?    @map("config_schema") // JSON schema for adapter config
  capabilities Json?    // array of capability slugs: start, stop, restart, status, send_command, stream_chat, kick_player, ban_player, install_mod, get_log_path — UI renders only these
  createdAt    DateTime @default(now()) @map("created_at")

  serverInstances ServerInstance[]
  modArtifacts    ModArtifact[]
}

model Host {
  id               String    @id @default(cuid())
  orgId            String    @map("org_id")
  name             String
  lastHeartbeatAt  DateTime? @map("last_heartbeat_at")
  agentVersion     String?   @map("agent_version")
  agentKeyVersion  Int       @default(1) @map("agent_key_version") // incremented on rotation; JWT jti/version must match
  status           String?   @default("unknown") // online | offline | degraded — updated on heartbeat or periodic sweep
  lastMetrics      Json?     @map("last_metrics") // CPU, RAM, disk from last heartbeat (dashboard)
  labels           Json?     // e.g. {"env":"prod","region":"us"} for filtering
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  org              Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  serverInstances  ServerInstance[]
  jobRuns          JobRun[]
  pairingTokenUsed PairingToken?     @relation("TokenUsedByHost")
  healthSamples    HealthSample[]

  @@index([orgId])
  @@index([orgId, status])
}

model PairingToken {
  id           String    @id @default(cuid())
  orgId        String    @map("org_id")
  tokenHash    String    @map("token_hash")   // SHA-256 of plaintext token; never store plaintext
  expiresAt    DateTime  @map("expires_at")
  usedAt       DateTime? @map("used_at")     // set when consumed → single-use
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  usedByHostId String?   @unique @map("used_by_host_id") // set when paired; audit trail

  org       Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  usedByHost Host? @relation("TokenUsedByHost", fields: [usedByHostId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model ServerInstance {
  id              String   @id @default(cuid())
  orgId           String   @map("org_id")
  hostId          String   @map("host_id")
  gameTypeId      String   @map("game_type_id")
  name            String
  installPath     String?  @map("install_path")
  startCommand    String?  @map("start_command")
  telnetHost      String?  @map("telnet_host")
  telnetPort      Int?     @map("telnet_port")
  telnetPassword  String?  @map("telnet_password")
  maintenanceMode Boolean  @default(false) @map("maintenance_mode")
  rebootIfDown    Boolean  @default(false) @map("reboot_if_down")
  mapEmbedUrl     String?  @map("map_embed_url")
  config          Json?    // game-adapter-specific config
  port            Int?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  org             Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  host            Host             @relation(fields: [hostId], references: [id], onDelete: Restrict)
  gameType        GameType         @relation(fields: [gameTypeId], references: [id], onDelete: Restrict)
  userServerRoles UserServerRole[]
  jobs            Job[]
  banEntries      BanEntry[]
  commandMacros   CommandMacro[]
  schedules       Schedule[]
  serverLogs      ServerLog[]
  players         Player[]
  donations       Donation[]
  protectionSettings ServerProtectionSettings?
  triggers        Trigger[]

  @@index([orgId])
  @@index([hostId])
}

// ─── Schedules (cron, BullMQ delayed) ─────────────────────────────────────
model ServerLog {
  id               String   @id @default(cuid())
  orgId            String   @map("org_id")
  serverInstanceId String   @map("server_instance_id")
  content          String   @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  org            Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  serverInstance ServerInstance @relation(fields: [serverInstanceId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([serverInstanceId, createdAt(sort: Desc)])
}

model ServerProtectionSettings {
  id                    String   @id @default(cuid())
  serverInstanceId      String   @unique @map("server_instance_id")
  highPingEnabled       Boolean  @default(false) @map("high_ping_enabled")
  highPingThresholdMs   Int      @default(250) @map("high_ping_threshold_ms")
  highPingSamples       Int      @default(3) @map("high_ping_samples")
  highPingReason        String   @default("Connection latency remained too high") @map("high_ping_reason")
  countryBanEnabled     Boolean  @default(false) @map("country_ban_enabled")
  blockedCountryCodes   Json     @default("[]") @map("blocked_country_codes")
  countryAction         String   @default("kick") @map("country_action")
  countryBanDuration    String   @default("365 days") @map("country_ban_duration")
  countryReason         String   @default("Connections from your country are not allowed") @map("country_reason")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  serverInstance ServerInstance @relation(fields: [serverInstanceId], references: [id], onDelete: Cascade)
}

model HealthSample {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  hostId        String   @map("host_id")
  cpuPercent    Float    @map("cpu_percent")
  ramUsedMb     Float    @map("ram_used_mb")
  ramTotalMb    Float    @map("ram_total_mb")
  diskUsedGb    Float    @map("disk_used_gb")
  latencyMs     Float    @map("latency_ms")
  gameReachable Boolean  @map("game_reachable")
  createdAt     DateTime @default(now()) @map("created_at")

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  host Host @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([hostId, createdAt(sort: Desc)])
}

model Player {
  id                      String    @id @default(cuid())
  orgId                   String    @map("org_id")
  serverInstanceId        String    @map("server_instance_id")
  identityKey             String    @map("identity_key")
  steamId                 String?   @map("steam_id")
  eosId                   String?   @map("eos_id")
  entityId                Int?      @map("entity_id")
  ipAddress               String?   @map("ip_address")
  name                    String
  online                  Boolean   @default(false)
  currentSessionStartedAt DateTime? @map("current_session_started_at")
  lifetimeSeconds         Int       @default(0) @map("lifetime_seconds")
  zombieKills             Int       @default(0) @map("zombie_kills")
  playerKills             Int       @default(0) @map("player_kills")
  deaths                  Int       @default(0)
  level                   Int       @default(1)
  lastPosX                Float?    @map("last_pos_x")
  lastPosY                Float?    @map("last_pos_y")
  lastPosZ                Float?    @map("last_pos_z")
  lastLogoutAt            DateTime? @map("last_logout_at")
  lastInventory           Json?     @map("last_inventory")
  lastInventoryAt         DateTime? @map("last_inventory_at")
  supporter               Boolean   @default(false)
  supporterSince          DateTime? @map("supporter_since")
  totalDonatedCents       Int       @default(0) @map("total_donated_cents")
  portalPasswordHash      String?   @map("portal_password_hash")
  firstSeenAt             DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt              DateTime  @default(now()) @map("last_seen_at")

  org            Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  serverInstance ServerInstance @relation(fields: [serverInstanceId], references: [id], onDelete: Cascade)
  sessions       PlayerSession[]
  donations      Donation[]
  triggerFires   TriggerFire[]
  vehicleHistory PlayerVehicleHistory[]

  @@unique([serverInstanceId, identityKey])
  @@index([orgId, lastSeenAt(sort: Desc)])
  @@index([serverInstanceId, online])
  @@index([serverInstanceId, name])
}

model PlayerVehicleHistory {
  id             String    @id @default(cuid())
  playerId       String    @map("player_id")
  vehicleKey     String    @map("vehicle_key")
  itemName       String    @map("item_name")
  displayName    String    @map("display_name")
  entityId       Int?      @map("entity_id")
  lastPosX       Float?    @map("last_pos_x")
  lastPosY       Float?    @map("last_pos_y")
  lastPosZ       Float?    @map("last_pos_z")
  lastSeenAt     DateTime  @map("last_seen_at")
  lastReturnedAt DateTime? @map("last_returned_at")
  returnCount    Int       @default(0) @map("return_count")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, vehicleKey])
  @@index([playerId, lastSeenAt(sort: Desc)])
  @@map("player_vehicle_history")
}

model PlayerSession {
  id              String    @id @default(cuid())
  playerId        String    @map("player_id")
  startedAt       DateTime  @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?      @map("duration_seconds")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, startedAt(sort: Desc)])
}

model Donation {
  id                      String    @id @default(cuid())
  orgId                   String    @map("org_id")
  serverInstanceId        String    @map("server_instance_id")
  playerId                String    @map("player_id")
  steamId                 String    @map("steam_id")
  amountCents             Int       @map("amount_cents")
  refundedCents           Int       @default(0) @map("refunded_cents")
  currency                String    @default("usd")
  status                  String
  stripeCheckoutSessionId String    @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?   @map("stripe_payment_intent_id")
  shopItemId              String?   @map("shop_item_id")
  createdAt               DateTime  @default(now()) @map("created_at")
  completedAt             DateTime? @map("completed_at")
  refundedAt              DateTime? @map("refunded_at")

  org            Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  serverInstance ServerInstance @relation(fields: [serverInstanceId], references: [id], onDelete: Cascade)
  player         Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  shopItem       ShopItem?      @relation(fields: [shopItemId], references: [id], onDelete: SetNull)
  lines          DonationLine[]

  @@index([playerId, createdAt(sort: Desc)])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([stripePaymentIntentId])
  @@index([shopItemId])
}

model ShopItem {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  name        String
  description String   @default("")
  priceCents  Int      @map("price_cents")
  currency    String   @default("usd")
  imageExt    String?  @map("image_ext")
  imageMime   String?  @map("image_mime")
  grantItemName String? @map("grant_item_name")
  grantQuantity Int     @default(1) @map("grant_quantity")
  grantQuality  Int?    @map("grant_quality")
  grantItems    Json    @default("[]") @map("grant_items")
  chatColor     String? @map("chat_color")
  bonusLandClaims Int   @default(0) @map("bonus_land_claims")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org       Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  donations Donation[]
  donationLines DonationLine[]

  @@index([orgId, active, sortOrder])
}

model DonationLine {
  id          String   @id @default(cuid())
  donationId  String   @map("donation_id")
  shopItemId  String?  @map("shop_item_id")
  itemName    String   @map("item_name")
  amountCents Int      @map("amount_cents")
  quantity    Int      @default(1)
  grantItemName String?  @map("grant_item_name")
  grantQuantity Int?     @map("grant_quantity")
  grantQuality  Int?     @map("grant_quality")
  grantItems    Json     @default("[]") @map("grant_items")
  chatColor     String?  @map("chat_color")
  bonusLandClaims Int    @default(0) @map("bonus_land_claims")
  grantStatus   String   @default("none") @map("grant_status")
  chatColorStatus String @default("none") @map("chat_color_status")
  grantAttempts Int      @default(0) @map("grant_attempts")
  grantQueuedAt DateTime? @map("grant_queued_at")
  grantedAt     DateTime? @map("granted_at")
  grantError    String?  @map("grant_error")

  donation Donation  @relation(fields: [donationId], references: [id], onDelete: Cascade)
  shopItem ShopItem? @relation(fields: [shopItemId], references: [id], onDelete: SetNull)

  @@index([donationId])
  @@index([shopItemId])
  @@index([grantStatus])
  @@index([chatColorStatus])
}

model Schedule {
  id                   String    @id @default(cuid())
  orgId                String    @map("org_id")
  serverInstanceId     String    @map("server_instance_id")
  name                 String
  description          String?  @map("description")
  cronExpression       String    @map("cron_expression") // e.g. "0 2 * * *"
  jobType              String    @map("job_type")
  payload              Json?    @map("payload")
  enabled              Boolean   @default(true)
  executionWindowStart String?   @map("execution_window_start") // "HH:mm" optional
  executionWindowEnd   String?   @map("execution_window_end")   // "HH:mm" optional
  retryPolicy          Json?     @map("retry_policy")   // { maxRetries, backoffMs?, backoffType? }
  lastRunAt            DateTime? @map("last_run_at")
  nextRunAt            DateTime? @map("next_run_at")
  lastRunStatus        String?   @map("last_run_status") // success | failed | skipped | scheduler_failed
  lastRunJobId         String?   @map("last_run_job_id")
  skipNextRun          Boolean   @default(false) @map("skip_next_run")
  skipNextRunReason    String?   @map("skip_next_run_reason")
  skipNextRunRequestedAt DateTime? @map("skip_next_run_requested_at")
  runCount             Int       @default(0) @map("run_count")
  failureCount         Int       @default(0) @map("failure_count")
  createdById          String?   @map("created_by_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  org             Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  serverInstance  ServerInstance   @relation(fields: [serverInstanceId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([serverInstanceId])
  @@index([enabled, nextRunAt])
}

// ─── Jobs & history ────────────────────────────────────────────────────────
model JobBatch {
  id              String    @id @default(cuid())
  orgId           String    @map("org_id")
  type            String    @map("type") // restart_wave | update_wave | bulk_mod_install | custom
  status          String    @default("running") // running | completed | completed_with_failures | cancelled
  totalCount      Int       @map("total_count")
  pendingCount    Int       @default(0) @map("pending_count")
  runningCount    Int       @default(0) @map("running_count")
  successCount    Int       @default(0) @map("success_count")
  failedCount     Int       @default(0) @map("failed_count")
  cancelledCount  Int       @default(0) @map("cancelled_count")
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  org       Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User? @relation("JobBatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  jobs      Job[]

  @@index([orgId])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([status])
}

model Job {
  id               String   @id @default(cuid())
  orgId            String   @map("org_id")
  batchId          String?  @map("batch_id") // when set: part of bulk operation
  serverInstanceId String?  @map("server_instance_id") // null = org-wide job
  type             String   // start | stop | update | rcon | custom
  payload          Json?
  createdById      String?  @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")

  org             Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  batch           JobBatch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  serverInstance  ServerInstance?  @relation(fields: [serverInstanceId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  jobRuns         JobRun[]

  @@index([orgId])
  @@index([serverInstanceId])
  @@index([batchId])
  @@index([orgId, createdAt(sort: Desc)])
}

model JobRun {
  id         String    @id @default(cuid())
  jobId      String    @map("job_id")
  hostId     String    @map("host_id")
  status     String    // pending | running | success | failed | cancelled
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  result     Json?
  logRef     String?   @map("log_ref") // reference to log storage (e.g. S3 key or blob id)
  createdAt  DateTime  @default(now()) @map("created_at")

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  host Host @relation(fields: [hostId], references: [id], onDelete: Restrict)

  @@index([jobId])
  @@index([jobId, createdAt(sort: Desc)])
  @@index([hostId])
}

// ─── Events & alerts ───────────────────────────────────────────────────────
model Event {
  id         String   @id @default(cuid())
  orgId      String   @map("org_id")
  sourceType String   @map("source_type") // host | server_instance | job_run | system
  sourceId   String   @map("source_id")
  eventType  String   @map("event_type")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
}

model Trigger {
  id               String    @id @default(cuid())
  orgId            String    @map("org_id")
  serverInstanceId String    @map("server_instance_id")
  name             String
  enabled          Boolean   @default(true)
  eventType        String    @map("event_type")
  eventConfig      Json     @map("event_config")
  actionType       String    @map("action_type")
  actionConfig     Json     @map("action_config")
  applyToExisting  Boolean   @default(false) @map("apply_to_existing")
  lastFiredAt      DateTime? @map("last_fired_at")
  fireCount        Int       @default(0) @map("fire_count")
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  org             Org            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  serverInstance  ServerInstance @relation(fields: [serverInstanceId], references: [id], onDelete: Cascade)
  createdBy       User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  fires           TriggerFire[]

  @@index([orgId])
  @@index([serverInstanceId, enabled])
  @@map("triggers")
}

model TriggerFire {
  id        String   @id @default(cuid())
  triggerId String   @map("trigger_id")
  playerId  String   @map("player_id")
  eventKey  String   @map("event_key")
  jobId     String?  @map("job_id")
  status    String   @default("queued")
  createdAt DateTime @default(now()) @map("created_at")

  trigger Trigger @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  player  Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([triggerId, playerId, eventKey])
  @@index([triggerId, createdAt(sort: Desc)])
  @@map("trigger_fires")
}

model AlertRule {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  name      String
  condition Json     // e.g. { "type": "heartbeat_missed", "hostId": "..." }
  channel   Json     // e.g. { "type": "discord", "webhookUrl": "..." }
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ─── Bans & audit ──────────────────────────────────────────────────────────
model OrgBan {
  id               String    @id @default(cuid())
  orgId            String    @map("org_id")
  identifierType   String    @map("identifier_type") // steam_id | ip | name (7DTD: steam_id, ip)
  identifierValue  String    @map("identifier_value")
  reason           String?
  bannedAt         DateTime  @default(now()) @map("banned_at")
  expiresAt        DateTime? @map("expires_at")
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  org        Org         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy  User?       @relation("OrgBanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  banEntries BanEntry[]

  @@unique([orgId, identifierType, identifierValue])
  @@index([orgId])
}

model BanEntry {
  id               String    @id @default(cuid())
  orgId            String    @map("org_id")
  orgBanId         String?   @map("org_ban_id") // when set: sync record for this central ban on this server
  serverInstanceId String    @map("server_instance_id")
  identifierType   String    @map("identifier_type")
  identifierValue  String    @map("identifier_value")
  reason           String?
  bannedAt         DateTime  @default(now()) @map("banned_at")
  expiresAt        DateTime? @map("expires_at")
  createdById      String?   @map("created_by_id")
  syncStatus       String?   @map("sync_status")   // pending | synced | failed
  syncedAt         DateTime? @map("synced_at")
  lastSyncError    String?   @map("last_sync_error")
  lastSyncJobId    String?   @map("last_sync_job_id")

  org             Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgBan          OrgBan?          @relation(fields: [orgBanId], references: [id], onDelete: Cascade)
  serverInstance  ServerInstance   @relation(fields: [serverInstanceId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("BanEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([serverInstanceId])
  @@index([orgId, identifierType, identifierValue])
  @@index([orgBanId])
  @@index([serverInstanceId, syncStatus])
}

model AuditLog {
  id           String   @id @default(cuid())
  orgId        String   @map("org_id")
  actorId      String?  @map("actor_id")
  action       String   // create | update | delete | login | ...
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  details      Json?
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at")

  org  Org   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt(sort: Desc)])
}

// ─── Command macros (saved, parameterized, org/scoped) ─────────────────────
model CommandMacro {
  id                 String   @id @default(cuid())
  orgId              String   @map("org_id")
  name               String   // command palette label
  description        String?  // optional tooltip
  jobType            String   @map("job_type")   // SERVER_RESTART, RCON, custom, etc.
  payloadTemplate    Json     @map("payload_template") // keys with {{paramName}} in string values
  paramDefinitions   Json     @map("param_definitions") // [{ name, label?, default?, required? }]
  serverInstanceId   String?  @map("server_instance_id") // null = org-wide; set = fixed server
  allowedRoleNames   Json     @map("allowed_role_names") // ["admin","operator"] - who can execute
  createdById        String?  @map("created_by_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  org             Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  serverInstance  ServerInstance?  @relation(fields: [serverInstanceId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([serverInstanceId])
}

// ─── Mods (future-safe, minimal) ───────────────────────────────────────────
model ModArtifact {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  gameTypeId  String?  @map("game_type_id")
  name        String
  version     String?
  fileRef     String?  @map("file_ref") // path or storage key
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org      Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  gameType GameType?  @relation(fields: [gameTypeId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([gameTypeId])
}
