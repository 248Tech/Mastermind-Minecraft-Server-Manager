# Mastermind Agent — example config (YAML or JSON)
# Copy to config.local.yaml (gitignored) or /etc/mastermind-agent/config.yaml
# and set pairing_token for first run. Prefer env vars for secrets and paths.

control_plane_url: "http://127.0.0.1:3001"
# Set once for initial pairing; remove or leave empty after key is stored
pairing_token: ""
# Where to store the signed agent key after successful pairing
agent_key_path: "./data/agent.key"

heartbeat:
  interval_sec: 5  # 5–10 recommended

jobs:
  poll_interval_sec: 5
  long_poll_sec: 30   # 0 = short poll only; values above 120 are clamped
  max_concurrent_reads: 8
  websocket: false

logs:
  enabled: false
  path: ""
  server_instance_id: ""
  poll_interval_sec: 2

host:
  name: ""   # optional; control plane may set display name

discovery:
  enabled: true
  minecraft:
    enabled: true
    # Set YOUR server root (or use MASTERMIND_MC_INSTALL_PATH):
    # install_path: "C:/path/to/minecraft-server"
    # Optional overrides (or MASTERMIND_MC_* env vars):
    # server_properties_path: ""
    # mods_path: ""
    # plugins_path: ""
    # world_path: ""
    # start_command: ""
    # name: ""
