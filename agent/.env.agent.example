# Copy to agent/.env.agent (gitignored) and set YOUR values.
# Used by scripts/run-agent.ps1 — never commit real secrets or host-specific paths.

# Control plane the agent should talk to
MASTERMIND_CP_URL=http://127.0.0.1:3001

# One-time pairing token from dashboard → Hosts → Pair agent
# Leave blank after the agent key has been stored.
MASTERMIND_PAIRING_TOKEN=

# Where to store the paired agent key (relative or absolute)
MASTERMIND_KEY_PATH=./agent/data/agent.key

# Minecraft server root on THIS host (required for discovery)
MASTERMIND_MC_DISCOVERY_ENABLED=true
MASTERMIND_MC_INSTALL_PATH=C:/path/to/your/minecraft-server

# Optional overrides (leave blank to derive from install path / server.properties)
# MASTERMIND_MC_SERVER_PROPERTIES=
# MASTERMIND_MC_MODS_PATH=
# MASTERMIND_MC_PLUGINS_PATH=
# MASTERMIND_MC_WORLD_PATH=
# MASTERMIND_MC_START_COMMAND=
# MASTERMIND_MC_NAME=

# BlueMap / Dynmap public URL for Live Map embeds (not 127.0.0.1 unless browsers are local-only)
# MASTERMIND_MAP_PUBLIC_BASE=http://10.0.0.85:8100/
# MASTERMIND_MAP_PUBLIC_HOST=10.0.0.85
# MASTERMIND_MAP_ALLOW_LOOPBACK=1

# Optional host display name
# MASTERMIND_HOST_NAME=game-host-1
