{
  "name": "mastermind-web",
  "version": "0.14.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "next start",
    "lint": "next lint",
    "lint:ci": "next lint --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "check-env": "node -e \"if (!process.env.NEXT_PUBLIC_CONTROL_PLANE_URL) { console.error('NEXT_PUBLIC_CONTROL_PLANE_URL is not set'); process.exit(1); } console.log('env ok');\""
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "next": "^15.5.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.5.21",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "sharp": "^0.35.0"
    }
  }
}
